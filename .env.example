# SpirandeliEmpire OS 3.2 — Environment Configuration (Placeholders Only)

# Ports
WEB_PORT=8086

# Environment
APP_ENV=development
APP_DEBUG=true
APP_KEY=replace-with-random-secret-key-min-32-bytes
COOKIE_SECURE=false

# Authentication & Registration Policy (public | disabled | invite_only)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
REGISTRATION_MODE=public

# Admin Bootstrap (provide via environment/secret manager; never commit real passwords)
INITIAL_ADMIN_EMAIL=spirandelidev@gmail.com
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Proprietário / Administrador Principal

# Master encryption key for BYOK AI Provider secrets (AES-256-GCM / URL-safe base64 32 bytes)
ENCRYPTION_MASTER_KEY=replace-with-32-byte-base64-master-key
ENCRYPTION_KEY_VERSION=v1
PREVIOUS_ENCRYPTION_MASTER_KEY=

# PostgreSQL Database
POSTGRES_DB=spirandeliempire
POSTGRES_USER=spirandeli
POSTGRES_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgresql+asyncpg://spirandeli:replace-with-strong-db-password@localhost:5432/spirandeliempire

# Redis
REDIS_URL=redis://localhost:6379/0

# Optional Legacy Gemini API Key (migrated safely to Admin BYOK on startup if present)
GEMINI_API_KEY=
MODEL_CATALOG_CACHE_TTL_SECONDS=900
