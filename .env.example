# ==============================================================================
# SPIRANDELIEMPIRE OS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# WARNING: Do NOT commit your actual .env file to Git.
# Copy this file to .env on your VPS and update secrets appropriately.
# ==============================================================================

# --- PLATFORM CONFIGURATION ---
APP_NAME="SpirandeliEmpire OS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://empire.yourdomain.com
DOMAIN=empire.yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_PASSWORD=ChangeMeOnFirstLogin!2026

# --- FINANCIAL RESTRICTIONS & BUDGET GUARDRAILS ---
# Operational budget limit in BRL (as defined in specification: max R$ 200/month)
MONTHLY_BUDGET_LIMIT_BRL=200.00
ALERT_BUDGET_PERCENTAGE=80
STRICT_BUDGET_ENFORCEMENT=true
AUTO_APPROVE_EXPENSES=false

# --- DATABASE (PostgreSQL 16) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=spirandeli_empire
DB_USERNAME=empire_admin
DB_PASSWORD=secret_postgres_password_replace_me

# --- CACHE & QUEUE (Redis 7) ---
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secret_redis_password_replace_me

# --- JEFFREY AI ORCHESTRATOR & GOVERNANCE ---
JEFFREY_NAME="Jeffrey"
JEFFREY_CONTEXT_WINDOW=8192
JEFFREY_HUMAN_APPROVAL_REQUIRED=true
JEFFREY_AUDIT_LOG_ENABLED=true
JEFFREY_MEMORY_DRIVER=database

# ==============================================================================
# AI PROVIDERS & INTELLIGENT ROUTING GATEWAY (HYBRID: GOOGLE + OPENAI + LLAMA)
# ==============================================================================
# Estratégia de Provedores de IA:
# - hybrid: Prioriza Google Gemini (Free Tier/Créditos), faz fallback para OpenAI
#           (créditos/planos) e se tudo falhar ou offline, usa Llama local no Ollama (R$ 0,00).
# - gemini: Usa apenas Google Gemini (com fallback local se falhar)
# - openai: Usa apenas OpenAI (com fallback local se falhar)
# - ollama / llama: Usa exclusivamente o modelo Llama local rodando no VPS
AI_PROVIDER=hybrid
AI_FALLBACK_ORDER=gemini,openai,ollama

# --- TOKEN MANAGEMENT & TASK DELIMITATION RULES ---
# Delimita tarefas entre Llama local e APIs em nuvem conforme o volume de tokens
TOKEN_ROUTING_ENABLED=true
# Tarefas <= 800 tokens rodam prioritariamente no Llama local (poupa cota das APIs)
TOKEN_THRESHOLD_LOCAL_MAX=800
# Tarefas > 3500 tokens vão para o Google Gemini Flash (aproveita janela de 1M tokens)
TOKEN_THRESHOLD_LONG_CONTEXT=3500
# Teto diário de segurança de consumo de tokens em APIs
DAILY_API_TOKEN_CAP=500000

# --- 1. GOOGLE AI STUDIO / GEMINI (CRÉDITOS GRATUITOS & PLANOS) ---
# Obtenha sua chave de API gratuita em: https://aistudio.google.com/app/apikey
# A cota gratuita do Google AI Studio oferece até 15 RPM e 1 milhão de tokens/minuto
# sem gastar nada do orçamento mensal de R$ 200!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_FREE_TIER_MODE=true
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=4096

# --- 2. OPENAI (CRÉDITOS DE BOAS-VINDAS, TRIAL & PLANOS) ---
# Obtenha sua chave em: https://platform.openai.com/api-keys
# Use os créditos gratuitos iniciais da OpenAI ou modelo ultra-econômico gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# --- 3. LOCAL LLAMA & OLLAMA (100% GRATUITO & OFFLINE NO VPS) ---
# Zero dependência de internet para inferência quando necessário.
# Modelos recomendados para VPS 8GB: llama3.2:3b, llama3.2:1b, llama3.1:8b, qwen2.5:7b
OLLAMA_BASE_URL=http://ollama:11434
LLAMA_MODEL=llama3.2:3b
DEFAULT_TEXT_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=90

# --- MULTIMODAL & MEDIA ENGINES ---
COMFYUI_BASE_URL=http://comfyui:8188
PIPER_TTS_BINARY=/usr/local/bin/piper
PIPER_VOICE_MODEL=/opt/ai-engine/models/pt_BR-faber-medium.onnx
FFMPEG_BINARY=/usr/bin/ffmpeg

# --- GPU ON-DEMAND ABSTRACTION ---
# Modes: cpu_only | local_gpu | remote_on_demand
GPU_EXECUTION_MODE=cpu_only
GPU_REMOTE_ENABLED=false
GPU_REMOTE_PROVIDER=none
GPU_REMOTE_API_KEY=
GPU_MAX_IDLE_MINUTES=15
GPU_MAX_COST_PER_SESSION_BRL=15.00

# --- VPS MONITORING & INFRASTRUCTURE ---
VPS_METRICS_INTERVAL_SECONDS=60
UPTIME_KUMA_PORT=3001
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- BACKUP CONFIGURATION ---
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_RETENTION_DAYS=14
BACKUP_STORAGE_PATH=/var/spirandeli/backups
BACKUP_S3_REMOTE_ENABLED=false
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# --- BUSINESS FACTORY & INTEGRATIONS ---
YOUTUBE_API_ENABLED=false
YOUTUBE_API_KEY=
AMAZON_KDP_AUTO_PUBLISH=false
HOTMART_WEBHOOK_SECRET=
GUMROAD_ACCESS_TOKEN=
