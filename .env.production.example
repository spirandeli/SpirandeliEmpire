APP_NAME="SpirandeliEmpire"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://spirandeliempire.tech

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=abvos
DB_USERNAME=abvos
DB_PASSWORD=secret_db_password
DB_ROOT_PASSWORD=secret_root_password

SESSION_DRIVER=redis
SESSION_LIFETIME=10080
SESSION_DOMAIN=.spirandeliempire.tech

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=secret_redis_password
REDIS_PORT=6379

# Autenticação SPA vs Bearer Token: Deixar vazio para modo API Bearer Token (previne erro CSRF mismatch)
SANCTUM_STATEFUL_DOMAINS=

ABVOS_REGISTRATION_ENABLED=true
GEMINI_MODEL=gemini-3.8
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=

