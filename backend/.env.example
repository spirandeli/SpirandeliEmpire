APP_NAME="SpirandeliEmpire"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8080
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- MySQL 8.0 (mesmos valores do ./.env raiz) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=abvos
DB_USERNAME=abvos
DB_PASSWORD=change-me-db

# --- Redis (cache, sessões, filas, broadcasting) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
# Deve ser MAIOR que o --timeout dos workers (300s)
REDIS_QUEUE_RETRY_AFTER=420
BROADCAST_CONNECTION=redis

# --- Sanctum (SPA cookie auth) ---
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost,127.0.0.1:8080
FRONTEND_URL=http://localhost:8080
# Desligue em produção depois de criar sua conta
REGISTRATION_ENABLED=true

# --- E-mail (Mailpit em DEV) ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="agent@abvos.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Gemini (chave padrão do sistema; cada usuário pode salvar a sua em user_integrations) ---
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8
GEMINI_API_KEY=

# --- Google OAuth2 (Calendar + Tasks) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback
